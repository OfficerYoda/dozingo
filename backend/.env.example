DATABASE_URL=postgres://dozingo_user:dozingo_pass@localhost:5432/dozingo?sslmode=disable
# dozingo_test is created on container start (see docker/init.sql and docker-compose.yml)
TEST_DATABASE_URL=postgres://dozingo_user:dozingo_pass@localhost:5432/dozingo_test?sslmode=disable

PORT=4242

# whether to use https only cookies
SECURE_COOKIE=true

# 32-byte key for encrypting TOTP secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# API key for resend to send e-mails
RESEND_API_KEY=re_xxxxxx
MAIL_SENDER_ADDRESS=noreply@mail.example.com

# Garage (file storage)
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_PUBLIC_URL=http://web.garage.localhost:3902
GARAGE_ACCESS_KEY=GK_LOCAL_DEV_KEY_12345
GARAGE_SECRET_KEY=LOCAL_DEV_SECRET_PASSWORD_DO_NOT_USE_IN_PROD
GARAGE_BUCKET_NAME=profile-pictures
