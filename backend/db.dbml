Project bingo {
  database_type: 'PostgreSQL'
  Note: '''
    Dozingo
  '''
}

//// ============================================
//// IDENTITY & AUTH
//// ============================================

TablePartial timestamps {
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  username text [unique]
  email text [unique, not null]
  ~timestamps
}

Table user_authentications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  provider text [not null]
  provider_user_id text [not null]
  ~timestamps

  indexes {
    (provider, provider_user_id) [unique, name: 'uq_provider_identity']
  }
}

Ref: user_authentications.user_id > users.id [delete: cascade]

//// ============================================
//// BOARDS & CELLS
//// ============================================

Table boards {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null]
  description text
  size integer [not null, default: 5, note: 'size=5 means a 5x5 board']
  author_id uuid [not null]
  ~timestamps

  checks {
    `size >= 3 AND size <= 7` [name: 'chk_board_size']
  }
}

Ref: boards.author_id > users.id [delete: cascade]

Table cells {
  id uuid [pk, default: `gen_random_uuid()`]
  board_id uuid [not null]
  content text [not null]
  value integer
  author_id uuid [note: 'null = canonical cell, set = personal cell']
  ~timestamps
}

Ref: cells.board_id > boards.id [delete: cascade]
Ref: cells.author_id > users.id [delete: cascade]

//// ============================================
//// VOTES
//// ============================================

Table votes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  board_id uuid [not null]
  vote_value integer [not null]
  ~timestamps

  indexes {
    (user_id, board_id) [unique, name: 'uq_one_vote_per_user']
  }
  checks {
    `vote_value IN (1, -1)` [name: 'chk_vote_value']
  }
}

Ref: votes.user_id > users.id [delete: cascade]
Ref: votes.board_id > boards.id [delete: cascade]

//// ============================================
//// GAMES
//// ============================================

Table games {
  id uuid [pk, default: `gen_random_uuid()`]
  player_id uuid [not null]
  board_id uuid [note: 'null if board was deleted']
  status text [not null, default: 'active', note: 'active | completed | abandoned']
  ~timestamps

  checks {
    `status IN ('active', 'completed', 'abandoned')` [name: 'chk_game_status']
  }
}

Ref: games.player_id > users.id [delete: cascade]
Ref: games.board_id > boards.id [delete: set null]

Table game_cells {
  id uuid [pk, default: `gen_random_uuid()`]
  game_id uuid [not null]
  cell_id uuid [note: 'null if source cell was deleted']
  content text [not null, note: 'snapshot at game creation']
  position integer [not null]
  is_marked boolean [not null, default: false]
  ~timestamps

  indexes {
    (game_id, position) [unique, name: 'uq_game_cell_position']
  }
}

Ref: game_cells.game_id > games.id [delete: cascade]
Ref: game_cells.cell_id > cells.id [delete: set null]
