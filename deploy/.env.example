# Copy this file to .env and adjust if needed.
# The defaults here work out of the box for local demo.

# --- PostgreSQL ---
POSTGRES_USER=dozingo_user
POSTGRES_PASSWORD=dozingo_pass
POSTGRES_DB=dozingo

# --- Backend ---
# Must point to the postgres service name defined in docker-compose.yml
DATABASE_URL=postgres://dozingo_user:dozingo_pass@postgres:5432/dozingo?sslmode=disable
PORT=4242
# Set to false for local HTTP (no TLS)
SECURE_COOKIE=false

# AES-256-GCM key for TOTP secrets at rest.
# This value is a safe local-demo key — do NOT use in production.
# Generate your own with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=/N0W66pDSW3ziU2GaXHOoMHdB8+nSqxdpw4h2c2Gu1g=

# Email (Resend) — dummy values keep the app running locally.
# Password-reset and verification emails won't be delivered.
RESEND_API_KEY=re_dummy_local_dev
MAIL_SENDER_ADDRESS=noreply@localhost

# --- Garage (S3-compatible object storage for avatars) ---
# GARAGE_ENDPOINT is the internal service URL (container-to-container).
# GARAGE_PUBLIC_URL is used by the browser to load avatar images.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_PUBLIC_URL=http://localhost:3902
GARAGE_ACCESS_KEY=GK_LOCAL_DEV_KEY_12345
GARAGE_SECRET_KEY=LOCAL_DEV_SECRET_PASSWORD_DO_NOT_USE_IN_PROD
GARAGE_BUCKET_NAME=profile-pictures

# Used by the garage container to bootstrap the bucket on first start.
GARAGE_DEFAULT_ACCESS_KEY=GK_LOCAL_DEV_KEY_12345
GARAGE_DEFAULT_SECRET_KEY=LOCAL_DEV_SECRET_PASSWORD_DO_NOT_USE_IN_PROD
GARAGE_DEFAULT_BUCKET=profile-pictures
