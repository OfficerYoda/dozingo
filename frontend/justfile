# Default: list available commands
default:
    @just --list

# Run the Vite dev server (proxies /api -> localhost:4242)
run:
    npm run dev

# Type-check and build the production bundle into dist/
build:
    npm run build

# Type-check only (vue-tsc), no build
type-check:
    npm run type-check

# Serve the production build locally for smoke testing
preview:
    npm run preview

# Run tests once (CI mode)
test:
    npm run test:run

# Run tests in watch mode
test-watch:
    npm run test
